# Só para uso local da CLI (nunca vai para o navegador). Copie para .env.
# Senha do banco definida ao criar o projeto no Supabase (usada por `supabase link` / `db push`).
SUPABASE_DB_PASSWORD=
# Token pessoal (alternativa ao `supabase login`): https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
